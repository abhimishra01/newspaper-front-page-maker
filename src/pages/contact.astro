---
import Page from '../layouts/Page.astro';
import site from '../site.config.ts';
---
<Page noindex title="Contact" description="Contact the team behind Newspaper Front Page Maker. Report a bug, suggest a layout or ask how the free front page tool works. We reply within a few days.">
  <p>We want to hear about bugs, ideas and anything that is unclear.</p>
  <p>{site.contactWord}: <a href={site.contactHref}>{site.contactLabel}</a></p>
  <p>We try to reply within a few days. Please include the browser and device you use if you report a problem.</p>
</Page>
