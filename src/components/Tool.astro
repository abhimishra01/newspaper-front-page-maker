---
// The editor. The page is drawn on a canvas from src/lib/np/layout.js; ui.js wires the controls.
import { PRESETS, PRESET_IDS, FIELDS } from '../lib/np/presets.js';
import { FORMATS, FORMAT_IDS } from '../lib/np/formats.js';
import { TEMPLATES } from '../lib/np/layout.js';
import { url } from '../lib/url.ts';
---
<div id="tool" class="np" data-font={url('fonts/masthead.woff2')}>
  <div class="np-grid">
    <div class="np-stage">
      <p class="np-hint" id="np-hint">Tap any text on the page to change it.</p>
      <div class="np-wrap" id="np-wrap">
        <canvas id="np-canvas" role="img" aria-label="Preview of your newspaper front page"></canvas>
        <div id="np-hits" class="np-hits"></div>
        <div id="np-editor-box" class="np-editor" hidden>
          <label for="np-editor" id="np-editor-label" class="np-editor-label">Headline</label>
          <textarea id="np-editor" rows="2" spellcheck="true"></textarea>
          <button type="button" class="btn-sm" id="np-editor-done">Done</button>
        </div>
        <div id="np-drop" class="np-drop" hidden><span>Drop the photo to add it</span></div>
      </div>
      <div class="np-actions" id="np-actions">
        <button type="button" class="btn btn-primary" id="np-png">Download PNG</button>
        <button type="button" class="btn" id="np-pdf">Download PDF</button>
        <button type="button" class="btn" id="np-print">Print</button>
        <button type="button" class="btn" id="np-share" hidden>Share</button>
      </div>
      <p class="np-status" id="np-status" role="status" aria-live="polite"></p>
      <p class="np-private"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 1 2.5 3v4.2c0 3.4 2.3 6.4 5.5 7.8 3.2-1.4 5.5-4.4 5.5-7.8V3L8 1Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m5.5 8 1.8 1.8L10.8 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>Your photo stays on this device. Nothing is uploaded.</p>
    </div>

    <div class="np-panel">
      <fieldset class="np-sec">
        <legend>1. Occasion</legend>
        <div class="np-chips" role="radiogroup" aria-label="Occasion">
          {PRESET_IDS.map((id) => (
            <label class="np-chip"><input type="radio" name="np-occasion" value={id} /><span>{PRESETS[id].label}</span></label>
          ))}
        </div>
        <div class="np-row">
          <label class="np-field"><span>Name</span><input class="ctl" id="np-name" type="text" autocomplete="off" maxlength="60" /></label>
          <label class="np-field np-num" id="np-num-wrap"><span id="np-num-label">Age</span><input class="ctl" id="np-num" type="text" inputmode="numeric" autocomplete="off" maxlength="8" /></label>
        </div>
        <div class="np-row">
          <label class="np-field"><span>Date on the page</span><input class="ctl" id="np-date" type="date" /></label>
          <button type="button" class="btn np-surprise" id="np-surprise">Surprise me</button>
        </div>
      </fieldset>

      <fieldset class="np-sec">
        <legend>2. Look</legend>
        <div class="np-templates" role="radiogroup" aria-label="Layout">
          {Object.values(TEMPLATES).map((t) => (
            <label class="np-tpl">
              <input type="radio" name="np-template" value={t.id} />
              <span class="np-tpl-card">
                {t.id === 'classic' && (
                  <svg viewBox="0 0 60 78" aria-hidden="true"><rect x=".5" y=".5" width="59" height="77" rx="2" class="pg"/><rect x="8" y="5" width="44" height="6" class="ink"/><rect x="4" y="13" width="52" height="1" class="ink"/><rect x="4" y="17" width="52" height="5" class="ink"/><rect x="4" y="25" width="34" height="18" class="ph"/><rect x="4" y="46" width="16" height="26" class="tx"/><rect x="22" y="46" width="16" height="26" class="tx"/><rect x="41" y="25" width="15" height="4" class="ink"/><rect x="41" y="31" width="15" height="41" class="tx"/></svg>
                )}
                {t.id === 'tabloid' && (
                  <svg viewBox="0 0 60 78" aria-hidden="true"><rect x=".5" y=".5" width="59" height="77" rx="2" class="pg"/><rect x="4" y="4" width="52" height="11" class="ink"/><circle cx="49" cy="9.5" r="4.5" class="yel"/><rect x="4" y="18" width="52" height="22" class="ph"/><rect x="6" y="20" width="12" height="3.5" class="red"/><rect x="4" y="43" width="52" height="9" class="ink"/><rect x="4" y="55" width="16" height="17" class="tx"/><rect x="22" y="55" width="16" height="17" class="tx"/><rect x="41" y="55" width="15" height="17" class="box"/></svg>
                )}
                {t.id === 'vintage' && (
                  <svg viewBox="0 0 60 78" aria-hidden="true"><rect x=".5" y=".5" width="59" height="77" rx="2" class="pg sep"/><rect x="3" y="3" width="54" height="72" class="frame"/><rect x="10" y="7" width="40" height="6" class="ink"/><rect x="6" y="16" width="48" height="1.5" class="ink"/><rect x="9" y="20" width="42" height="5" class="ink"/><rect x="6" y="28" width="23" height="15" class="ph"/><rect x="6" y="45" width="11" height="26" class="tx"/><rect x="18" y="45" width="11" height="26" class="tx"/><rect x="31" y="28" width="11" height="43" class="tx"/><rect x="43" y="28" width="11" height="43" class="tx"/></svg>
                )}
                <span>{t.name}</span>
              </span>
            </label>
          ))}
        </div>
        <div class="np-row">
          <label class="np-field"><span>Name style</span>
            <select class="ctl" id="np-face"><option value="auto">Match the layout</option><option value="old">Old English</option><option value="serif">Bold serif</option><option value="sans">Bold sans</option></select>
          </label>
          <label class="np-field"><span>Paper</span>
            <select class="ctl" id="np-paper"><option value="tint">Newsprint tint</option><option value="white">White (saves ink)</option></select>
          </label>
        </div>
        <div class="np-row">
          <label class="np-field"><span>Photo look</span>
            <select class="ctl" id="np-look"><option value="auto">Match the layout</option><option value="color">Color</option><option value="bw">Black and white</option><option value="halftone">Halftone dots</option></select>
          </label>
          <label class="np-check"><input type="checkbox" id="np-notice" /><span>Show the "Novelty print" label</span></label>
        </div>
      </fieldset>

      <fieldset class="np-sec" id="np-photos">
        <legend>3. Photos</legend>
        {[['main', 'Main photo'], ['side', 'Second photo (second story)']].map(([slot, label]) => (
          <div class="np-photo" data-slot={slot}>
            <div class="np-photo-head">
              <span class="np-photo-title">{label}</span>
              <span class="np-photo-name" data-role="name"></span>
            </div>
            <div class="np-photo-btns">
              <label class="btn np-file"><input type="file" accept="image/*" data-role="file" class="sr-only" /><span data-role="add">Add photo</span></label>
              <button type="button" class="btn" data-role="remove" hidden>Remove</button>
            </div>
            <label class="np-zoom" data-role="zoom-wrap" hidden><span>Zoom</span><input type="range" min="1" max="3" step="0.05" value="1" data-role="zoom" /></label>
            <p class="np-note" data-role="note"></p>
          </div>
        ))}
        <p class="np-note">Drag the photo on the page to move it. You can also drop a photo on the page.</p>
      </fieldset>

      <fieldset class="np-sec">
        <legend>4. Size</legend>
        <div class="np-sizes" role="radiogroup" aria-label="Size">
          {FORMAT_IDS.map((id) => (
            <label class="np-size"><input type="radio" name="np-format" value={id} /><span>{FORMATS[id].name}</span></label>
          ))}
        </div>
      </fieldset>

      <details class="np-sec np-all" id="np-all">
        <summary>All text on the page</summary>
        <div class="np-fields">
          {FIELDS.map((f) => (
            <div class="np-f">
              <label for={`np-f-${f.id}`}>{f.label}</label>
              {f.line
                ? <input class="ctl" type="text" id={`np-f-${f.id}`} data-field={f.id} autocomplete="off" />
                : <textarea class="ctl" id={`np-f-${f.id}`} data-field={f.id} rows={f.id === 'body' ? 6 : f.id === 'sideBody' ? 4 : 2}></textarea>}
              <span class="np-f-note" data-note={f.id}></span>
            </div>
          ))}
        </div>
      </details>

      <div class="np-reset"><button type="button" class="link" id="np-reset">Start over</button><span class="np-note">Your text is saved on this device. Photos are never saved.</span></div>
    </div>
  </div>
  <div id="np-print-area" class="np-print-area" aria-hidden="true"></div>
</div>
<style is:inline id="np-page-style"></style>
<script>
  import { start } from '../lib/np/ui.js';
  start();
</script>
